# Copy to .env.local. Never commit real credentials.
SUPABASE_URL=https://ivxbrhqqfgmhfpgpauzh.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server only: invitations, demo seeding and notification worker. Never a browser key.
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key
# Exact origin, no trailing slash. Set separately for each protected deployment.
APP_ORIGIN=http://localhost:4173
# production or demo; demo accounts cannot enter production API and vice versa.
APP_WORKSPACE=production
# Gmail optional. Queued records remain queued when absent; demo mail is suppressed.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
OWNER_EMAIL=
# Explicit authorized recipient for a live notification test. No automatic test mail.
AUTHORIZED_TEST_EMAIL=
# Required only by secure local demo setup; use email addresses you control.
DEMO_ADMIN_EMAIL=
DEMO_CUSTOMER_EMAIL=
DEMO_SECOND_CUSTOMER_EMAIL=
