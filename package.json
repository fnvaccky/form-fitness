{
  "name": "form-fitness",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "description": "Private connected gym membership management system",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/dev.js",
    "dev": "node --watch --env-file-if-exists=.env.local src/dev.js",
    "check": "node scripts/check.js",
    "build": "node build.cjs",
    "test": "node --test tests/unit.test.js tests/paymongo-unit.test.js tests/reset-test-data.test.js tests/attendance.test.js tests/recommendations.test.js",
    "test:integration": "node --env-file-if-exists=.env.local tests/integration.js",
    "test:browser": "node --env-file-if-exists=.env.local tests/browser.js",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.js",
    "package:source": "node scripts/package-source.js",
    "test:auth": "node --env-file-if-exists=.env.local tests/auth.js",
    "test:onboarding": "node --env-file-if-exists=.env.local tests/onboarding.js",
    "test:registration": "node --env-file-if-exists=.env.local tests/registration-resilience.js",
    "test:paymongo": "node --env-file-if-exists=.env.local tests/paymongo.js",
    "test:staff": "node --env-file-if-exists=.env.local tests/staff.js",
    "test:emails": "node --env-file-if-exists=.env.local tests/email-uniqueness.js",
    "test:links": "node --env-file-if-exists=.env.local tests/auth-links.js",
    "test:passwords": "node --env-file-if-exists=.env.local tests/password-fields.js",
    "test:accounts": "node --env-file-if-exists=.env.local tests/accounts.js",
    "test:reset": "node --env-file-if-exists=.env.local tests/reset-test-data.js",
    "test:attendance": "node --env-file-if-exists=.env.local tests/attendance.js",
    "test:pass": "node --env-file-if-exists=.env.local tests/pass-check.js",
    "test:survey": "node tests/survey-browser.js",
    "test:survey-flow": "node --env-file-if-exists=.env.local tests/survey.js",
    "test:next-cycle": "node --env-file-if-exists=.env.local tests/next-cycle.js",
    "test:plans": "node --env-file-if-exists=.env.local tests/plans.js",
    "test:plans-concurrency": "node tests/plans-concurrency.js",
    "test:recommendations": "node --env-file-if-exists=.env.local tests/recommendations.js",
    "reset:test-data": "node --env-file-if-exists=.env.local scripts/reset-test-data.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/analytics": "^2.0.1",
    "cookie": "2.0.1",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "agent-browser": "0.38.1",
    "archiver": "8.0.0",
    "playwright": "1.63.0",
    "qrcode": "1.5.4"
  }
}
